        },
        "probability_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "FEATURE_CONDITIONAL",
            "HISTORICAL_REFERENCE",
            null
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
