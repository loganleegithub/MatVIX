{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matvix.local/schemas/daily_output.schema.json",
  "title": "MatVIX v3 Daily Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "feature_version",
    "state_version",
    "probability_version",
    "input_manifest_hash",
    "session_date",
    "decision_as_of",
    "data_status",
    "market_story",
    "probability_judgment",
    "observations",
    "diagnostics",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "model_id": {
      "const": "MATVIX_CBOE_CORE_V3"
    },
    "feature_version": {
      "const": "3.0.0"
    },
    "state_version": {
      "const": "3.0.0"
    },
    "probability_version": {
      "const": "3.0.0"
    },
    "input_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "decision_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "data_status": {
      "enum": [
        "OK",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "market_story": {
      "$ref": "#/$defs/marketStory"
    },
    "probability_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acute_front_stress_5d",
        "front_inversion_5d",
        "mid_curve_pressure_accelerates_5d",
        "broad_stress_persists_10d",
        "carry_environment_recovers_10d"
      ],
      "properties": {
        "acute_front_stress_5d": {
          "$ref": "#/$defs/event"
        },
        "front_inversion_5d": {
          "$ref": "#/$defs/event"
        },
        "mid_curve_pressure_accelerates_5d": {
          "$ref": "#/$defs/event"
        },
        "broad_stress_persists_10d": {
          "$ref": "#/$defs/event"
        },
        "carry_environment_recovers_10d": {
          "$ref": "#/$defs/event"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "feature",
        "raw_value",
        "percentile",
        "contribution",
        "meaning"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "raw_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contribution": {
          "type": "number"
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "marketStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "phase",
        "pressure_level",
        "direction",
        "baseline_score",
        "structure",
        "answers",
        "scores",
        "drivers",
        "counter_evidence",
        "repair_evidence",
        "structural_triggers",
        "what_changes_the_view",
        "narrative"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "UNKNOWN",
            "ACUTE_FRONT_STRESS",
            "REPAIR_IN_PROGRESS",
            "BROAD_PERSISTENT_STRESS",
            "PRESSURE_DIFFUSING",
            "FRONT_LOCALIZED_STRESS",
            "TAIL_RICH_QUIET_CURVE",
            "CARRY_SUPPORTIVE_LOW_STRESS",
            "MIXED_TRANSITION"
          ]
        },
        "pressure_level": {
          "enum": [
            "LOW",
            "WATCH",
            "ELEVATED",
            "HIGH",
            "EXTREME",
            "UNKNOWN"
          ]
        },
        "direction": {
          "enum": [
            "RISING",
            "FALLING",
            "STABLE",
            "UNKNOWN"
          ]
        },
        "baseline_score": {
          "$ref": "#/$defs/score"
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stress_tenor_scope",
            "mid_curve_pressure_state",
            "carry_environment_state"
          ],
          "properties": {
            "stress_tenor_scope": {
              "enum": ["NONE", "FRONT", "MID", "BROAD", "UNKNOWN"]
            },
            "mid_curve_pressure_state": {
              "enum": ["QUIET", "RISING", "PRICED", "RECEDING", "UNKNOWN"]
            },
            "carry_environment_state": {
              "enum": ["OPEN", "CLOSED", "RECOVERING", "UNKNOWN"]
            }
          }
        },
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "carry",
            "shock",
            "tail",
            "persistence",
            "repair",
            "outlook"
          ],
          "properties": {
            "carry": {
              "enum": [
                "SUPPORTIVE",
                "MIXED",
                "STRESSED",
                "INVERTED",
                "UNKNOWN"
              ]
            },
            "shock": {
              "enum": [
                "CALM",
                "BUILDING",
                "HIGH",
                "ACUTE",
                "UNKNOWN"
              ]
            },
            "tail": {
              "enum": [
                "NORMAL",
                "ELEVATED",
                "RICH",
                "EXTREME",
                "UNKNOWN"
              ]
            },
            "persistence": {
              "enum": [
                "NORMAL",
                "FRONT_LOCALIZED",
                "DIFFUSING",
                "PERSISTENT",
                "MIXED",
                "UNKNOWN"
              ]
            },
            "repair": {
              "enum": [
                "INACTIVE",
                "BUILDING",
                "CONFIRMED",
                "UNKNOWN"
              ]
            },
            "outlook": {
              "type": "string"
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "carry_risk",
            "shock",
            "tail_price",
            "persistence",
            "repair"
          ],
          "properties": {
            "carry_risk": {
              "$ref": "#/$defs/score"
            },
            "shock": {
              "$ref": "#/$defs/score"
            },
            "tail_price": {
              "$ref": "#/$defs/score"
            },
            "persistence": {
              "$ref": "#/$defs/score"
            },
            "repair": {
              "$ref": "#/$defs/score"
            }
          }
        },
        "drivers": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "counter_evidence": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "repair_evidence": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "structural_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what_changes_the_view": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "narrative": {
          "type": "string"
        }
      }
    },
    "eventCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_status",
        "model_status",
        "probability_kind",
        "raw_probability",
        "probability",
        "base_rate",
        "uplift",
        "calibration_method",
        "calibration_samples",
        "calibration_positive",
        "calibration_negative",
