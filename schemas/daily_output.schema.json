        "raw_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "base_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uplift": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "calibration_method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ROLLING_INTERCEPT_252",
            "IDENTITY_WARMUP",
            "NOT_APPLICABLE",
            null
          ]
        },
        "calibration_samples": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 252
        },
        "calibration_positive": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 252
        },
        "calibration_negative": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 252
        },
        "intercept_b": {
          "type": [
            "number",
            "null"
          ]
        },
        "valid_through_session": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "interpretation": {
          "type": "string"
        }
      }
    },
