{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matvix.local/schemas/prospective_outcome.schema.json",
  "title": "MatVIX Prospective 001 Outcome Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "scientific_cohort_id",
    "activation_tag",
    "session_date",
    "event_id",
    "horizon_sessions",
    "valid_through_session",
    "outcome_available_at",
    "resolved_at",
    "resolved_late",
    "label",
    "label_status",
    "first_event_session",
    "prediction",
    "target_ledger",
    "resolver_release_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "OUTCOME_RESOLVED"},
    "scientific_cohort_id": {"const": "MATVIX_V3_0_1_CORE"},
    "activation_tag": {"const": "matvix-prospective-001-activation"},
    "session_date": {"type": "string", "format": "date"},
    "event_id": {
      "enum": [
        "acute_front_stress_5d",
        "front_inversion_5d",
        "mid_curve_pressure_accelerates_5d",
        "broad_stress_persists_10d",
        "carry_environment_recovers_10d"
      ]
    },
    "horizon_sessions": {"enum": [5, 10]},
    "valid_through_session": {"type": "string", "format": "date"},
    "outcome_available_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolved_late": {"type": "boolean"},
    "label": {"enum": [0, 1]},
    "label_status": {"enum": ["OBSERVED_0", "OBSERVED_1"]},
    "first_event_session": {
      "type": ["string", "null"],
      "format": "date"
    },
    "prediction": {"$ref": "#/$defs/fileBinding"},
    "target_ledger": {"$ref": "#/$defs/fileBinding"},
    "resolver_release_id": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
